  "description": "CivManager - Enterprise Project & Expense Control",
  "main": "App.tsx",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "test:e2e:ios": "detox build -c ios.sim.debug && detox test -c ios.sim.debug",
    "test:e2e:android": "detox build -c android.emulator.debug && detox test -c android.emulator.debug",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
