{
  "name": "Sai_App",
  "version": "2.4.0",
  "description": "CivManager - Enterprise Project & Expense Control",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:supabase": "node -e \"const { runSupabaseTest } = require('./src/utils/testSupabaseConnection'); runSupabaseTest();\"",
    "test:connection": "node -e \"const { runSupabaseTest } = require('./src/utils/supabaseTest'); runSupabaseTest();\"",
    "test:e2e": "pytest tests/testsuites/test_supabase_e2e.py -v",
    "test:integration": "pytest tests/testsuites/test_supabase_integration.py -v",
    "test:all": "npm run test:supabase && npm run test:integration && npm run test:e2e",
    "test:step-by-step": "pytest tests/testsuites/test_supabase_e2e.py::TestSupabaseE2E::test_01_supabase_configuration -v",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "check-all": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-masked-view/masked-view": "^0.3.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "~52.0.0",
    "expo-font": "~13.0.0",
    "expo-status-bar": "~2.0.1",
    "http-errors": "^2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20 <26"
  }
}
