    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-preset-expo": "^54.0.10",
    "detox": "^20.47.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.2.0",
    "jest": "^29.7.0",
    "jest-environment-miniflare": "^2.7.1",
