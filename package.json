    "@react-navigation/stack": "^7.6.16",
    "@types/react-native": "^0.72.8",
    "@types/react-native-vector-icons": "^6.4.18",
    "date-fns": "^4.1.0",
    "expo": "~53.0.26",
    "expo-status-bar": "~3.0.9",
    "lodash": "^4.17.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.79.6",
    "react-native-gesture-handler": "~2.28.0",
