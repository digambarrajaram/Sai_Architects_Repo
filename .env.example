# Test User Configuration
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPassword123
TEST_USER_ROLE=supervisor

# Role-based credentials for Owner and Supervisor
OWNER_EMAIL=owner@gmail.com
OWNER_PASSWORD=Owner@123

SUPERVISOR_EMAIL=supervisor@gmail.com
SUPERVISOR_PASSWORD=Supervisor@123

# Supabase Configuration (Expo client-side variables require EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Android Device Configuration
ANDROID_DEVICE_NAME=Android
APP_PACKAGE=com.anonymous.sai_app
APP_ACTIVITY=.MainActivity

# Appium Configuration
APPIUM_SERVER_URL=http://localhost:4723

# Test Configuration
ELEMENT_TIMEOUT=30
APP_STARTUP_TIMEOUT=60
TEST_DATA_PREFIX=TEST_
CLEANUP_ENABLED=true
SCREENSHOT_ENABLED=true
VERBOSE_LOGGING=false

# Database Configuration
SUPABASE_TIMEOUT=30000
DB_POLL_INTERVAL=1000

# Advanced Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=2.0
PARALLEL_EXECUTION=false

# Android-specific capabilities
ANDROID_PLATFORM_VERSION=12
ANDROID_DEVICE_UDID=
SYSTEM_PORT=
CHROME_DRIVER_PORT=
NO_RESET=false
FULL_RESET=false
AUTO_GRANT_PERMISSIONS=true
UNICODE_KEYBOARD=true
RESET_KEYBOARD=true
AUTOMATION_NAME=UiAutomator2